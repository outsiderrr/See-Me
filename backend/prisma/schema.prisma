generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  // 登录标识。存之前一律 trim + 转小写（routes/auth.ts）——2026-08-03 踩过标识符
  // 写法不一致（带不带 +86）导致同一个人分裂成两个账号的事故，归一化是硬要求。
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  notes    Note[]
  tags     Tag[]
  cards    Card[]
  holdings CardHolder[]
  sessions Session[]

  @@map("users")
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  body      String
  topic     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags NoteTag[]
  images   NoteImage[]

  @@index([userId, createdAt])
  @@map("notes")
}

model Tag {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  name     String
  icon     String?
  pinnedAt DateTime? @map("pinned_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags  NoteTag[]
  shareTags ShareTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteImage {
  id        String @id @default(cuid())
  noteId    String @map("note_id")
  mimeType  String @map("mime_type")
  data      Bytes
  sortOrder Int    @default(0) @map("sort_order")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, sortOrder])
  @@map("note_images")
}

model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

// kind: 'private' = login card (OTP + 8-char invite code, CardHolder binding) |
// 'open' = link-only card read at /c/<public_slug> with no account and no reader
// record anywhere. A DB CHECK constraint (see the open-cards migration) keeps the
// two columns in lockstep: only an open card may carry a slug, and it always does.
model Card {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  title        String
  kind         String   @default("private")
  visibleUntil DateTime @map("visible_until") @db.Timestamptz(6)
  inviteCode   String   @unique @map("invite_code")
  publicSlug   String?  @unique @map("public_slug")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares  Share[]
  holders CardHolder[]

  @@map("cards")
}

// A "share" = one shareable rule inside a card. The reader sees it as a tab/chip
// under `name`. A note matches a share iff it has ALL of the share's include tags
// AND NONE of its exclude tags (spec §3: intersection + exclusion).
model Share {
  id           String   @id @default(cuid())
  cardId       String   @map("card_id")
  name         String
  isAutoUpdate Boolean  @default(false) @map("is_auto_update")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  card      Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  shareTags ShareTag[]

  @@map("shares")
}

model ShareTag {
  shareId String  @map("share_id")
  tagId   String  @map("tag_id")
  exclude Boolean @default(false) // false = include (AND), true = exclude (NOT)

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([shareId, tagId])
  @@map("share_tags")
}

model CardHolder {
  id         String   @id @default(cuid())
  cardId     String   @map("card_id")
  userId     String   @map("user_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@map("card_holders")
}

model EmailOtp {
  email     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_otps")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime @map("window_end") @db.Timestamptz(6)

  @@map("rate_limits")
}
