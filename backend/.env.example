NODE_ENV=development
PORT=3000
OTP_SECRET=dev-only-change-me-please-use-32+bytes-in-prod
MAIL_DRIVER=dev
# 只有 MAIL_DRIVER=resend 时才需要这两项
# RESEND_API_KEY=
# MAIL_FROM=Fathom <noreply@fathomlog.com>
SESSION_TTL_DAYS=60
# Local dev: src/dev.ts boots embedded-postgres and sets DATABASE_URL automatically to this.
# Production (Docker): point DATABASE_URL at the postgres container.
DATABASE_URL=postgresql://seeme:seeme@127.0.0.1:5440/see_me

# Where embedded-postgres keeps its data. Keep this OUTSIDE iCloud-synced
# folders (Desktop/Documents) — live DB files there get evicted and corrupt.
PGDATA_DIR=~/.seeme-pgdata
