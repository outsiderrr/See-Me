NODE_ENV=development
PORT=3000
OTP_SECRET=dev-only-change-me-please-use-32+bytes-in-prod
SMS_DRIVER=dev
SESSION_TTL_DAYS=60
# Local dev: src/dev.ts boots embedded-postgres and sets DATABASE_URL automatically to this.
# Production (Docker): point DATABASE_URL at the postgres container.
DATABASE_URL=postgresql://seeme:seeme@127.0.0.1:5440/see_me
