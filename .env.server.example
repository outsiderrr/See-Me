# Server secrets for docker-compose. Copy to .env (gitignored) and fill in.

# Postgres password (invent a long random one; only containers see it).
DB_PASSWORD=

# OTP hashing secret (invent a long random one; changing it invalidates
# in-flight login codes, not sessions).
OTP_SECRET=

# 登录验证码走邮件。'dev' 只把码打进 app 容器日志
# (docker compose logs -f app)；'resend' 真发信，需要下面两项。
MAIL_DRIVER=dev

# resend.com 的 API key（re_ 开头）。MAIL_DRIVER=resend 时必填。
RESEND_API_KEY=

# 发信人，域名必须已在 Resend 验证过，例如 Fathom <noreply@fathomlog.com>
MAIL_FROM=

# 过渡期（真发信还没配好）用 dev 驱动、码从容器日志读，必须显式设成 1。
# 配好真发信后删掉它——留着等于把明文验证码一直写进日志。
MAIL_DEV_IN_PROD=1
