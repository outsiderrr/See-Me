# Server secrets for docker-compose. Copy to .env (gitignored) and fill in.

# Postgres password (invent a long random one; only containers see it).
DB_PASSWORD=

# OTP hashing secret (invent a long random one; changing it invalidates
# in-flight login codes, not sessions).
OTP_SECRET=

# 登录验证码走邮件：
#   dev    只把码打进 app 容器日志（docker compose logs -f app）
#   aliyun 阿里云邮件推送——收件方是 126/163/QQ 时选它，国内投递率高
#   resend 境外服务，收件方是 Gmail 等海外邮箱时够用
MAIL_DRIVER=dev

# resend.com 的 API key（re_ 开头）。MAIL_DRIVER=resend 时必填。
RESEND_API_KEY=

# 发信人，域名必须已在 Resend 验证过，例如 Fathom <noreply@fathomlog.com>
MAIL_FROM=

# --- MAIL_DRIVER=aliyun 时填这几项 ---
# RAM 用户的密钥，只需授予 AliyunDirectMailFullAccess
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 控制台「发信地址」里配好并验证过的那个地址
ALIYUN_DM_ACCOUNT=
# 发信人昵称，少于 15 个字符（可留空）
ALIYUN_DM_FROM_ALIAS=Fathom
# 默认杭州（Version 2015-11-23）。换地域要同时改 endpoint 和 version，
# 例如新加坡是 https://dm.ap-southeast-1.aliyuncs.com/ + 2017-06-22
# ALIYUN_DM_ENDPOINT=
# ALIYUN_DM_VERSION=

# 过渡期（真发信还没配好）用 dev 驱动、码从容器日志读，必须显式设成 1。
# 配好真发信后删掉它——留着等于把明文验证码一直写进日志。
MAIL_DEV_IN_PROD=1
