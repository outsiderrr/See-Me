# Server secrets for docker-compose. Copy to .env (gitignored) and fill in.

# Postgres password (invent a long random one; only containers see it).
DB_PASSWORD=

# OTP hashing secret (invent a long random one; changing it invalidates
# in-flight login codes, not sessions).
OTP_SECRET=

# 'dev' prints login codes to the app container logs
# (docker compose logs -f app). Switch to 'aliyun' after the SMS
# signature is approved and the driver is wired.
SMS_DRIVER=dev
